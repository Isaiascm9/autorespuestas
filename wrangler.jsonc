{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autorespuestas",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // La base de datos se crea sola la primera vez que Cloudflare publica. No hace falta ningún ID.
  "d1_databases": [{ "binding": "DB", "database_name": "autorespuestas" }],
  // Cada hora: seguimientos automáticos y reanudar clientes en pausa.
  // Una vez al día (desde las 9:00 a. m. de Caracas): renueva tokens, guarda los seguidores del día y limpia registros viejos.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
